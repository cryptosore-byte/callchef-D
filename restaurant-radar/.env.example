# --- Apify (Phase 2) -------------------------------------------------------
# Create a token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=
# Optional. Defaults to compass~crawler-google-places (the most common Google Maps actor)
APIFY_GOOGLE_MAPS_ACTOR_ID=compass~crawler-google-places

# --- Jev / TypeSafe decision API (Phase 5) ---------------------------------
TYPESAFE_API_KEY=
# Optional override. Default: https://api.typesafe.ai/v1/systemone
TYPESAFE_API_URL=

# --- Optional LLM for review classification + short explanations -----------
OPTIONAL_LLM_API_KEY=
OPTIONAL_LLM_PROVIDER=

# --- Database (Phase 8) ----------------------------------------------------
DATABASE_URL=

# --- Cost limits (all optional, defaults shown) ----------------------------
MAX_NEARBY_RESTAURANTS=30
MAX_REVIEWS_TARGET=200
MAX_REVIEWS_PER_COMPETITOR=50
MAX_COMPETITORS_ANALYZED=5
SCAN_CACHE_HOURS=24

# --- Self-hosting -----------------------------------------------------------
# Optional HTTP Basic auth password for the whole site (any user name).
SITE_PASSWORD=

# --- Continuous intelligence (optional, defaults shown) ------------------------
# Where restaurant history and the provider cache are stored (persist this on your server)
DATA_DIR=
LIGHT_REFRESH_MIN_DAYS=6
MONTHLY_REFRESH_DAYS=30
DEEP_SCAN_MAX_AGE_DAYS=90
# Cost ceilings in USD (estimates from the unit prices below, not invoices)
MAX_DEEP_SCAN_BUDGET=1.0
MAX_LIGHT_REFRESH_BUDGET=0.15
MAX_MONTHLY_REFRESH_BUDGET=0.5
COST_APIFY_RUN=0.005
COST_APIFY_PLACE=0.004
COST_APIFY_REVIEW=0.0006
REVIEWS_STRONG_BENCHMARK=50
REVIEWS_SECONDARY=20
