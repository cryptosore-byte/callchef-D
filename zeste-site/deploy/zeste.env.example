# Copié vers /etc/zeste/zeste.env par install.sh. Après modification :
#   sudo systemctl restart zeste
# Tant qu'un champ est vide, le formulaire reste en mode « aperçu » et n'envoie rien.

# Adresse publique du site, sans / à la fin (doit correspondre exactement au domaine).
PUBLIC_ORIGIN=https://__DOMAIN__

# Serveur d'envoi. Exemple avec une boîte mail Hostinger :
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@__DOMAIN__
SMTP_PASSWORD=

# Expéditeur (en général la même adresse que SMTP_USER) et destinataire des demandes.
MAIL_FROM=contact@__DOMAIN__
MAIL_TO=
